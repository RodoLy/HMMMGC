<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- The runtime's application manifest (hmmm-native.rc puts it in the program). -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="HMMMGC.HarvestMoonMM.Native" version="1.0.0.0"/>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- Paths with any letter: the program's "ANSI" code page, which its command line, its
           environment and its files go through, is UTF-8 (Windows 10 1903 and newer). The launcher
           passes the disc's path and the player's folder in UTF-8. -->
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
