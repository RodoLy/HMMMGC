// The launcher's version resource, which Windows shows in the program's Properties (Details) and
// antivirus programs read: what the program is, which project it belongs to and its version.
// CMake fills it in from HMMM_PACKAGE_VERSION (launcher/CMakeLists.txt).
//
// El recurso de versión del launcher: lo que Windows muestra en Propiedades (Detalles) y lo que
// leen los antivirus. CMake lo llena con la versión del paquete.
#include <winver.h>

1 VERSIONINFO
FILEVERSION @HMMM_VERSION_NUMBERS@
PRODUCTVERSION @HMMM_VERSION_NUMBERS@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "HMMMGC (https://github.com/RodoLy/HMMMGC)"
            VALUE "FileDescription", "Harvest Moon: Magical Melody native PC port - launcher"
            VALUE "FileVersion", "@HMMM_PACKAGE_VERSION@"
            VALUE "InternalName", "HarvestMoonMM"
            VALUE "LegalCopyright", "GPL-3.0 (see LICENSE). Not affiliated with the game's publishers."
            VALUE "OriginalFilename", "HarvestMoonMM.exe"
            VALUE "ProductName", "HMMMGC - Harvest Moon: Magical Melody native port"
            VALUE "ProductVersion", "@HMMM_PACKAGE_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
