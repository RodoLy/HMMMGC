+/// The picture of a frame, as the window is about to show it.
+struct PresentPicture {
+  wgpu::Texture texture;
+  wgpu::TextureView view;
+  wgpu::Extent3D size;
+  wgpu::TextureFormat format;
+  wgpu::Sampler sampler;
+  float aspect; ///< the shape it is shown at (width / height), or 0 when its size gives it
+};
+
+/// Called on the render thread once a frame, with the frame's command encoder, after the frame is
+/// drawn and before the window shows it: it may draw the picture somewhere else too (another
+/// surface), and may change `picture` so that the window shows another one instead.
+using PresentHook = void (*)(const wgpu::CommandEncoder& encoder, PresentPicture& picture);
+/// Called on the render thread once the frame's commands are submitted.
+using AfterPresentHook = void (*)();
+void set_present_hooks(PresentHook before, AfterPresentHook after) noexcept;
+
 } // namespace aurora::webgpu
