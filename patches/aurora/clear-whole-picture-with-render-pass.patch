diff --git a/lib/gx/gx.cpp b/lib/gx/gx.cpp
index e373bf0..9664012 100644
--- a/lib/gx/gx.cpp
+++ b/lib/gx/gx.cpp
@@ -266,6 +266,20 @@ Vec2<uint32_t> logical_fb_size() noexcept {
   return gfx::is_offscreen() ? gfx::get_render_target_size() : vi::configured_fb_size();
 }
 
+bool covers_whole_picture(const gfx::ClipRect& rect) noexcept {
+  if (gfx::is_offscreen()) {
+    return false;
+  }
+  const auto [targetWidth, targetHeight] = gfx::get_render_target_size();
+  if (targetWidth == 0 || targetHeight == 0) {
+    return false;
+  }
+  // The picture is as wide as the EFB and starts at its first row; how many rows it has is the
+  // game's choice (448 of the EFB's 528 here), and aurora is not told it when the game's own VI
+  // library runs instead of aurora's.
+  return rect.x == 0 && rect.y == 0 && rect.width == static_cast<int32_t>(targetWidth) && rect.height > 0;
+}
