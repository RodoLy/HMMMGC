diff --git a/lib/gx/gx.cpp b/lib/gx/gx.cpp
index e373bf0..95716dc 100644
--- a/lib/gx/gx.cpp
+++ b/lib/gx/gx.cpp
@@ -266,6 +266,21 @@ Vec2<uint32_t> logical_fb_size() noexcept {
   return gfx::is_offscreen() ? gfx::get_render_target_size() : vi::configured_fb_size();
 }
 
+bool covers_whole_picture(const gfx::ClipRect& rect) noexcept {
+  if (gfx::is_offscreen()) {
+    return false;
+  }
+  const uint32_t efbHeight = vi::configured_fb_size().y;
+  const uint32_t pictureHeight = vi::visible_fb_size().y;
+  const auto [targetWidth, targetHeight] = gfx::get_render_target_size();
+  if (efbHeight == 0 || targetWidth == 0 || targetHeight == 0) {
+    return false;
+  }
+  const auto pictureBottom = static_cast<int64_t>(pictureHeight) * targetHeight / efbHeight;
+  return rect.x == 0 && rect.y == 0 && rect.width == static_cast<int32_t>(targetWidth) &&
+         static_cast<int64_t>(rect.y) + rect.height >= pictureBottom;
+}
