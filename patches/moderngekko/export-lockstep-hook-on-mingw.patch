diff --git a/GXRuntime/src/core/cpu.c b/GXRuntime/src/core/cpu.c
index 345b960..f0f636d 100644
--- a/GXRuntime/src/core/cpu.c
+++ b/GXRuntime/src/core/cpu.c
@@ -24,7 +24,10 @@
  * offset (into cpu->ram) about to be written, `size` the width in bytes. */
 PPCMemWriteJournal g_mem_write_journal = NULL;
 void* g_mem_write_journal_user = NULL;
-#if defined(_MSC_VER)
+#if defined(_WIN32)
+/* On every Windows compiler, MSVC and the MinGW ones alike (module_export.c does the same): a
