 __declspec(dllexport) void ppc_set_mem_write_journal(PPCMemWriteJournal fn, void* user) {
 #else
 __attribute__((visibility("default"))) void ppc_set_mem_write_journal(PPCMemWriteJournal fn, void* user) {
