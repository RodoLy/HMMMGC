+// What InspectGame does besides recognising the game.
+struct InspectOptions
+{
+  // Hash every file under files/ into GameMetadata::assets_sha256. That reads the whole game (about
+  // 1.4 GB for a GameCube disc): seconds on a fast disk, and much longer when a virus scanner checks
+  // each file as it is read. Only the check that pins a release to its assets and the netplay
+  // compatibility check use the hash. When this is false, assets_sha256 stays empty.
+  bool hash_assets = true;
+};
+
+GameInspectResult InspectGame(const std::filesystem::path& root, InspectOptions options = {});
 std::optional<std::string> HashFileSha256(const std::filesystem::path& path);
 std::optional<std::string> HashDirectorySha256(const std::filesystem::path& root);
