diff --git a/tools/game_inspection.hpp b/tools/game_inspection.hpp
new file mode 100644
index 0000000..0914c53
--- /dev/null
+++ b/tools/game_inspection.hpp
@@ -0,0 +1,19 @@
+#pragma once
+
+#include "moderngekko/game.hpp"
+
+namespace moderngekko::frontend {
+// How the launcher and the runner inspect the game they are about to play.
+//
+// Reading every file of the game to hash it takes a long time (see InspectOptions), and the hash is
+// only compared with something when this build pins the game's files to a release
+// (MODERNGEKKO_REQUIRED_ASSETS_SHA256), so only such a build hashes them when the game starts.
+// A netplay session hashes them on its own, when it starts, because the players compare that hash.
+inline InspectOptions GameInspectionOptions() {
+#ifdef MODERNGEKKO_REQUIRED_ASSETS_SHA256
+  return {.hash_assets = true};
+#else
+  return {.hash_assets = false};
+#endif
+}
+} // namespace moderngekko::frontend
