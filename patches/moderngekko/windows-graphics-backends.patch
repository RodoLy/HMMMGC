+// The name of a graphics API without case, spaces, hyphens or underscores, so that "DirectX 12",
+// "directx-12" and "D3D12" can be compared.
+std::string CompactName(std::string_view value) {
+  std::string compact;
+  for (const unsigned char c : value) {
+    if (c != ' ' && c != '-' && c != '_')
+      compact.push_back(static_cast<char>(std::tolower(c)));
+  }
+  return compact;
+}
