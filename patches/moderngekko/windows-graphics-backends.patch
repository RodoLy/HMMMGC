+std::string NormalizeGraphicsBackend(std::string_view name,
+                                     GraphicsPlatform platform) {
+  const std::string compact_name = CompactName(Trim(std::string(name)));
+  const std::vector<GraphicsBackendOption> backends =
+      GraphicsBackendsFor(platform);
+  for (const GraphicsBackendOption &backend : backends) {
+    if (compact_name == CompactName(backend.text) ||
+        compact_name == CompactName(backend.value))
+      return backend.value;
+  }
+  for (const GraphicsBackendAlias &alias : kGraphicsBackendAliases) {
+    if (compact_name != alias.name)
+      continue;
+    // An alias is a name for an API that the platform may not have.
+    const bool platform_has_it = std::ranges::any_of(
+        backends, [&](const GraphicsBackendOption &backend) {
+          return std::string_view(backend.value) == alias.value;
+        });
+    if (platform_has_it)
+      return alias.value;
+  }
+  return {};
+}
