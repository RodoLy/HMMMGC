+  switch (platform) {
+  case GraphicsPlatform::WindowsOnArm:
+    // DirectX 12 comes first because it is the one that works on the Snapdragon laptop where this
+    // was tried: the game runs with it, while with Vulkan its window stays black.
+    // Dolphin does not build its OpenGL backend for Windows on ARM.
+    return {direct3d12, direct3d11, vulkan};
+  case GraphicsPlatform::Windows:
+    // Vulkan stays the default, as it was; DirectX is there for the computers where it fails.
+    return {vulkan, direct3d11, direct3d12, opengl};
+  case GraphicsPlatform::Other:
+    break;
+  }
+  return {vulkan, opengl};
