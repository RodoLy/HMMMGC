diff --git a/tools/moderngekko_port.cpp b/tools/moderngekko_port.cpp
index af1c2a5..173c297 100644
--- a/tools/moderngekko_port.cpp
+++ b/tools/moderngekko_port.cpp
@@ -564,6 +564,23 @@ int Inspect(const fs::path& root, const fs::path& output)
   return 0;
 }
 
+// The folder with the files that building a module needs: the module template, the runtime's
+// sources and the game settings. It is the source tree this tool was built from, unless the tool
+// was moved to another machine, which happens when it is shipped in a package. Then the folders
+// copied to `source/` beside the executable, laid out the same, or $MODERNGEKKO_SOURCE_DIR
+// (which wins over both), take its place.
+fs::path ModuleSourceRoot(const char* argv0)
+{
+  if (const char* from_environment = std::getenv("MODERNGEKKO_SOURCE_DIR");
+      from_environment && *from_environment)
+    return from_environment;
+  std::error_code ec;
+  const fs::path beside_executable = fs::weakly_canonical(argv0, ec).parent_path() / "source";
+  if (fs::is_directory(beside_executable / "vendor/dolphin/module-template", ec))
+    return beside_executable;
+  return fs::path(MODERNGEKKO_SOURCE_DIR);
+}
+
 std::optional<fs::path> Build(const char* argv0, const fs::path& root,
                               BuildOptions options)
 {
